# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# ABA PayWay - sandbox keys come from https://sandbox.payway.com.kh/register-sandbox/
# Production keys come from paywaysales@ababank.com
# ---------------------------------------------------------------------------
PAYWAY_ENV=sandbox
PAYWAY_MERCHANT_ID=
PAYWAY_API_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supplier adapters (see supabase/migrations for the supplier tables)
# ---------------------------------------------------------------------------
FAZERCARDS_API_KEY=
FOXRELOAD_API_KEY=
MARIX_API_KEY=
RELOADLY_CLIENT_ID=
RELOADLY_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Support surfaces
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
RESEND_API_KEY=
