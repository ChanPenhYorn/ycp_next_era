# ---------------------------------------------------------------------------
# Local only. Never commit this file - it holds the service role key.
#
#   cp .env.local.example .env.local
#
# Values come from https://supabase.com/dashboard/project/ozelquxztpqpjikhgnxd
# ---------------------------------------------------------------------------

# Project Settings -> General -> Reference ID
SUPABASE_PROJECT_REF=ozelquxztpqpjikhgnxd

# The first admin. Sign up with this address in the app, then run
# ./scripts/bootstrap-admin.sh. Admins add other staff from /admin/staff.
ADMIN_EMAIL=

# Project Settings -> Database -> Connection string (the password part)
# Needed by `supabase db push`. Not uploaded as a function secret.
DATABASE_PASSWORD=

# ---------------------------------------------------------------------------
# Project Settings -> API
# ---------------------------------------------------------------------------

# Project URL: https://<ref>.supabase.co
SUPABASE_URL=https://ozelquxztpqpjikhgnxd.supabase.co

# "publishable" key (older projects call it `anon`). Safe in the app, protected
# by RLS. This is the one that goes into the Flutter --dart-define.
SUPABASE_PUBLISHABLE_KEY=

# "secret" key (older projects call it `service_role`). BYPASSES ALL RLS.
# Server-side only: Edge Functions and nothing else. Never in the app bundle,
# never in a chat, never in git.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Sandbox sign-in
#
# Set this and ./scripts/run-app.sh runs the app against the local stack with a
# fixed code instead of sending email:
#
#   supabase start
#   SUPABASE_URL=http://127.0.0.1:54321 ./scripts/run-app.sh -d chrome
#
# The code only takes effect on a loopback URL (see Env.devAuthEnabled). Leave it
# unset for the hosted project, where real email OTP is the only path.
# ---------------------------------------------------------------------------
DEV_OTP=123456

# ---------------------------------------------------------------------------
# Google sign-in (Supabase Auth provider, not a function secret)
#
# Google Cloud -> APIs & Services -> Credentials -> OAuth client ID, type "Web
# application". Authorised redirect URIs:
#   http://127.0.0.1:54321/auth/v1/callback   (local stack)
#   https://<ref>.supabase.co/auth/v1/callback (hosted)
# Then either paste the pair into Authentication -> Providers -> Google in the
# hosted dashboard, or run ./scripts/google-signin.sh --on for the local stack.
# ---------------------------------------------------------------------------
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# ---------------------------------------------------------------------------
# ABA PayWay
#
# Sandbox: https://sandbox.payway.com.kh/register-sandbox/ (key emailed to you)
# Production: request from paywaysales@ababank.com
# ---------------------------------------------------------------------------
PAYWAY_ENV=sandbox
PAYWAY_MERCHANT_ID=
PAYWAY_API_KEY=

# ---------------------------------------------------------------------------
# Suppliers
#
# Used by `supabase secrets set --env-file .env.local` for the HOSTED project.
# Local functions read supabase/functions/.env instead, which is a different
# file: putting the key only here leaves local syncs answering
# `supplier_not_configured`.
# ---------------------------------------------------------------------------
BAY2GAME_API_KEY=
SUPPLIER_JOB_SECRET=

# --- Banner art (IGDB) -----------------------------------------------------
# Read by `game-banner`. Free Twitch application credentials from
# https://dev.twitch.tv/console/apps. Leave unset to disable the automatic
# lookup; staff can still paste an explicit image URL in the admin console.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# --- Card payments (Dodo) --------------------------------------------------
# Hosted project only. The card tile also needs
#   update public.settings set dodo_enabled = true;
# and a Pay What You Want one-time USD product in the Dodo dashboard.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PRODUCT_ID=
