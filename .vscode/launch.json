{
  // The Flutter project lives in app/, so both cwd and the flavor config paths
  // resolve through ${workspaceFolder} whether VS Code opened the repo root or
  // app/.
  //
  // dev  = local Supabase stack, fixed sign-in code, nothing emailed.
  // prod = the hosted project, real email OTP.
  //
  // Only pick a prod config when you mean it: the hosted mailer allows 2 emails
  // per hour, so a few careless runs lock sign-in for everyone until the window
  // rolls over. Use dev for building screens.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Chanpenh dev (Chrome)",
      "request": "launch",
      "type": "dart",
      "program": "${workspaceFolder}/app/lib/main.dart",
      "cwd": "${workspaceFolder}/app",
      "args": ["-d", "chrome", "--dart-define-from-file=config/dev.json"]
    },
    {
      "name": "Chanpenh dev (device)",
      "request": "launch",
      "type": "dart",
      "program": "${workspaceFolder}/app/lib/main.dart",
      "cwd": "${workspaceFolder}/app",
      "args": ["--dart-define-from-file=config/dev.json"]
    },
    {
      "name": "Chanpenh prod (Chrome)",
      "request": "launch",
      "type": "dart",
      "program": "${workspaceFolder}/app/lib/main.dart",
      "cwd": "${workspaceFolder}/app",
      "args": ["-d", "chrome", "--dart-define-from-file=config/prod.json"]
    },
    {
      "name": "Chanpenh prod (device)",
      "request": "launch",
      "type": "dart",
      "program": "${workspaceFolder}/app/lib/main.dart",
      "cwd": "${workspaceFolder}/app",
      "args": ["--dart-define-from-file=config/prod.json"]
    }
  ]
}
