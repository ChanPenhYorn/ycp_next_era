{
  // The Flutter project lives in app/. Paths are absolute via ${workspaceFolder}
  // so they resolve the same whether VS Code opened the repo root or app/.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Sela (Chrome)",
      "request": "launch",
      "type": "dart",
      "program": "${workspaceFolder}/app/lib/main.dart",
      "cwd": "${workspaceFolder}/app",
      "args": [
        "-d",
        "chrome",
        "--dart-define=SUPABASE_URL=https://ozelquxztpqpjikhgnxd.supabase.co",
        "--dart-define=SUPABASE_PUBLISHABLE_KEY=sb_publishable_Pkf6mahsgfWeW6CydARzPg_C641KzHR"
      ]
    },
    {
      "name": "Sela (device)",
