# ---------------------------------------------------------------------------
# Local only. Never commit this file - it holds the service role key.
#
#   cp .env.local.example .env.local
#
# Values come from https://supabase.com/dashboard/project/ozelquxztpqpjikhgnxd
# ---------------------------------------------------------------------------

# Project Settings -> General -> Reference ID
SUPABASE_PROJECT_REF=ozelquxztpqpjikhgnxd

# Project Settings -> Database -> Connection string (the password part)
# Needed by `supabase db push`. Not uploaded as a function secret.
DATABASE_PASSWORD=

# ---------------------------------------------------------------------------
# Project Settings -> API
# ---------------------------------------------------------------------------

# Project URL: https://<ref>.supabase.co
SUPABASE_URL=https://ozelquxztpqpjikhgnxd.supabase.co

# "publishable" key (older projects call it `anon`). Safe in the app, protected
# by RLS. This is the one that goes into the Flutter --dart-define.
SUPABASE_PUBLISHABLE_KEY=

# "secret" key (older projects call it `service_role`). BYPASSES ALL RLS.
# Server-side only: Edge Functions and nothing else. Never in the app bundle,
# never in a chat, never in git.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Sandbox sign-in
#
# Set this and ./scripts/run-app.sh runs the app against the local stack with a
# fixed code instead of sending email:
#
#   supabase start
#   SUPABASE_URL=http://127.0.0.1:54321 ./scripts/run-app.sh -d chrome
#
# The code only takes effect on a loopback URL (see Env.devAuthEnabled). Leave it
# unset for the hosted project, where real email OTP is the only path.
# ---------------------------------------------------------------------------
DEV_OTP=123456

# ---------------------------------------------------------------------------
# ABA PayWay
#
# Sandbox: https://sandbox.payway.com.kh/register-sandbox/ (key emailed to you)
# Production: request from paywaysales@ababank.com
# ---------------------------------------------------------------------------
PAYWAY_ENV=sandbox
PAYWAY_MERCHANT_ID=
PAYWAY_API_KEY=

# ---------------------------------------------------------------------------
# Suppliers
#
# Used by `supabase secrets set --env-file .env.local` for the HOSTED project.
# Local functions read supabase/functions/.env instead, which is a different
# file: putting the key only here leaves local syncs answering
# `supplier_not_configured`.
# ---------------------------------------------------------------------------
BAY2GAME_API_KEY=
SUPPLIER_JOB_SECRET=
