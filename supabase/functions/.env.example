# Local function environment. Gitignored, like the rest of the env files.
#
# The CLI copies this file into the container environment at creation, so after
# editing it run `supabase stop && supabase start`. `docker restart` and a plain
# `supabase start` do not pick up the change.
#
# --- ABA PayWay ------------------------------------------------------------
# PAYWAY_ENV=stub stands in for ABA so checkout, the QR sheet and settlement all
# work with no credentials. The stub refuses to engage outside a local stack, so
# it cannot approve money on a hosted project.
#
# For a real sandbox run set PAYWAY_ENV=sandbox and fill in both values from
# https://sandbox.payway.com.kh (Developer -> API credentials), not from a
# payment link. On the hosted project use `supabase secrets set --env-file`.
PAYWAY_ENV=stub
PAYWAY_MERCHANT_ID=
PAYWAY_API_KEY=

# Optional stub knobs, useful for exercising the failure branches:
#   PAYWAY_STUB_SETTLE_SECONDS=6 -> how long the QR waits before it is approved
#                                   (0 makes it approve instantly, which closes
#                                   the sheet the moment it opens)
#   PAYWAY_STUB_STATE=DECLINED   -> the sheet shows the declined state
#   PAYWAY_STUB_UNDERPAY=1       -> settlement refuses an underpayment

# --- Sandbox sign-in -------------------------------------------------------
# DEV_OTP switches on dev-signin, the sandbox stand-in for email OTP. Unset it
# and the function answers 404 with no code change. It must never be set on a
# hosted project: there it would be a fixed-code login.
#
# Verify with: ./scripts/verify-sandbox.sh --check-disabled
DEV_OTP=123456

# --- Suppliers -------------------------------------------------------------
# Read by supplier-sync and supplier-fulfil at runtime. The supplier key is a
# QUERY PARAMETER on their API, so it only ever belongs in a server-side
# environment like this one, never in the app bundle.
#
# The CLI bakes this file into the container when it is created, so after
# changing it run `supabase stop && supabase start`, not just `docker restart`.
#
# SUPPLIER_JOB_SECRET guards both workers. When it is unset they accept any
# caller, which is fine locally and wrong on a hosted project.
BAY2GAME_API_KEY=
SUPPLIER_JOB_SECRET=

# The origin a BROWSER can reach. Inside the local stack SUPABASE_URL is
# http://kong:8000, the compose-network name, so a storage URL built from it is
# unreachable from Chrome and mirrored product art silently never renders.
# On a hosted project this is the same as SUPABASE_URL, so leave it unset.
STORAGE_PUBLIC_URL=http://127.0.0.1:54321
