# ---------------------------------------------------------------------------
# Client (Flutter) - passed with --dart-define, never committed as a .env
#
#   flutter run \
#     --dart-define=SUPABASE_URL=https://<ref>.supabase.co \
#     --dart-define=SUPABASE_PUBLISHABLE_KEY=<publishable key>
#
# Only the client-safe key belongs here. Anything below marked "server" goes
# into Supabase secrets instead.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Supabase Edge Function secrets (server only)
#
#   supabase secrets set --env-file .env
#
# Get sandbox keys at https://sandbox.payway.com.kh/register-sandbox/
# Production keys come from paywaysales@ababank.com
# ---------------------------------------------------------------------------
PAYWAY_ENV=sandbox
PAYWAY_MERCHANT_ID=
PAYWAY_API_KEY=

# Set automatically by Supabase, listed here for local `supabase functions serve`.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Supplier adapters for auto-restock (see supplier_skus in the migrations)
# ---------------------------------------------------------------------------
FAZERCARDS_API_KEY=
FOXRELOAD_API_KEY=
MARIX_API_KEY=
RELOADLY_CLIENT_ID=
RELOADLY_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Support surfaces
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
